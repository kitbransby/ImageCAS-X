{
    "method_name": "ade_htl",
    "description": "ADE-HTL: anatomical dependency encoding + hierarchical topology learning with bottom-up attention interaction. Zhang et al., IEEE TMI 43(2):723-733, 2024.",
    "input_type": "ade_htl_crop",
    "output_type": "mask_connectivity_27ch",
    "data": {
        "params": {
            "patch_size": [
                160,
                160,
                64
            ],
            "min_fg_fraction": 0.5,
            "ade_dir": "ade_2026",
            "htl_targets_dir": "ade_htl_targets_2026",
            "chambers_dir": "TotalSegmentator",
            "chambers_suffix": ".heart.nii.gz",
            "max_keypoints": 64,
            "inference_batch_size": 2
        }
    },
    "model": {
        "name": "ade_htl",
        "params": {
            "in_channels": 6,
            "base_ch": 16,
            "n_levels": 5,
            "num_heads": 4,
            "kv_pool": 4
        },
        "checkpoint": null
    },
    "loss": {
        "name": "ade_htl",
        "params": {
            "lambda1": 0.5,
            "lambda2": 0.1
        }
    },
    "training": {
        "batch_size": 4,
        "lr": 0.0001,
        "amp": true,
        "cudnn_benchmark": true
    },
    "postprocessing": {
        "steps": [
            "connectivity_fuse",
            "keep_components_larger_than_100_voxels"
        ],
        "params": {
            "connectivity_fuse": {
                "threshold": 0.5,
                "min_connections": 2
            }
        }
    }
}
